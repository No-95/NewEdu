# Public Convex URL for client-side usage
NEXT_PUBLIC_CONVEX_URL=

# Public Convex URL for private messaging (second deployment)
NEXT_PUBLIC_CONVEX_MESSAGES_URL=

# Convex deployment site URL (server-side/internal usage)
CONVEX_SITE_URL=
CONVEX_MESSAGES_SITE_URL=https://fantastic-kookabura-624.convex.site

# Shared secret for DM notification bridge (Next.js + messages Convex)
MESSAGES_NOTIFY_SECRET=

# Resend credentials for OTP email sending (server-side only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=HDP EDU <onboarding@resend.dev>

# Book order notifications (Convex action + Resend). Default: minhhoangd852@gmail.com
BOOK_ORDER_NOTIFY_EMAIL=minhhoangd852@gmail.com

# Optional override for OTP signing
OTP_SIGNING_SECRET=

# Base URL for Cloudflare R2 HLS content (without trailing slash)
# Example: https://media.example.com/hdp1stcourse
R2_PUBLIC_BASE_URL=

# Gemini API integration (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# AI Worker proxy configuration (server-side only)
AI_WORKER_URL=
AI_WORKER_INTERNAL_TOKEN=

# Public site URL for email CTA links (no trailing slash). Falls back to https://hdpedu.com
SITE_URL=https://hdpedu.com

# Optional: allow OTP in API response when Resend fails (dev only)
AUTH_DEV_OTP_FALLBACK=

# Bearer token for /api/dev/* routes in production (optional)
DEV_SEED_SECRET=

# Public site URL for PayOS return/cancel redirects (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PayOS (payos.vn) course checkout — server-side only
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
